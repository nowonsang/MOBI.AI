#!/bin/sh
# push 전에 린트·타입 검사·단위 테스트·Android 빌드(Kotlin 컴파일, Pleos SDK 의존성)를 모두 통과해야 한다.
# 활성화: chmod +x .githooks/pre-push && git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "[pre-push] npm run verify (린트 · 타입 검사 · 단위 테스트 · Android 빌드) 실행 중..."
exec npm run verify
